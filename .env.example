# ======================================================
# Docker & Gunicorn
# ======================================================
WEB_PORT=8000
WORKERS=2

# ======================================================
# Conexión a la base de datos (PostgreSQL)
# ======================================================
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# Optional advanced DB configs
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# =================================================
# Configuración de Logging
# =================================================
LOG_LEVEL="DEBUG"       # DEBUG, INFO, WARNING, ERROR
LOG_TO_FILE="false"      # true o false
LOG_JSON="false"        # true o false
LOG_COLOR="true"        # true o false
LOG_DIR="logs"
LOG_FILENAME="app.log"

# =================================================
# Tamarin Logs Manager
# =================================================
TAMARIN_LOGS_ENABLED="false"  # true o false
TAMARIN_APP_NAME="Backend ANRO"
TAMARIN_APP_TOKEN=""
TAMARIN_API_URL="https://tamarin.macaqueconsulting.com/v1/tamarin/logs"

# =================================================
# Configuración de Mailjet
# =================================================
MAILJET_ENABLED="false"  # true o false
MAILJET_API_KEY="XXXXX"
MAILJET_API_SECRET="XXXXXXX"
MAILJET_SENDER_EMAIL="soporte@macaqueconsulting.com"
MAILJET_SENDER_NAME="DevOps MacaqueConsulting"
MAILJET_RECEIVER_EMAILS='["jonathan.sanchez@macaqueconsulting.com", "devops.macaqueconsulting@gmail.com"]'

# =================================================
# Swagger Documentation
# =================================================
SWAGGER_ENABLED=true
USER_SWAGGER=your-swagger-user
PASSWORD_SWAGGER=your-swagger-password

# =================================================
# CORS Configuration
# =================================================
CORS_ENABLED=true
# Use "*" to allow all origins (only for development)
# For production, specify exact origins separated by commas
CORS_ORIGINS="*"
# Example for production: CORS_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS="*"
CORS_ALLOW_HEADERS="*"

# =================================================
# JWT & Security Configuration
# =================================================
JWT_SECRET_KEY="your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30